# MongoDB Connection String
# For MongoDB Atlas, use format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# For local MongoDB, use: mongodb://localhost:27017
MONGODB_URI=your_mongodb_connection_string_here

# API Base URL (use localhost for development, your domain for production)
NEXT_PUBLIC_API_BASE_URL=https://sarvambuilders.com/api

# Base URL (use localhost for development, your domain for production)
NEXT_PUBLIC_BASE_URL=https://sarvambuilders.com
